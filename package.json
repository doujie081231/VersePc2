{
  "name": "verse-tauri",
  "version": "1.0.0",
  "description": "VersePC2 - 基于 Tauri 的 Minecraft 启动器",
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "node scripts/build-portable.mjs",
    "build:fast": "node scripts/build-portable.mjs --fast",
    "build:web": "vite build",
    "build:setup": "tauri build --bundles nsis",
    "build:portable": "node scripts/build-portable.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:density": "node scripts/check-test-density.mjs",
    "test:coverage:check": "node scripts/check-coverage.mjs",
    "test:e2e": "npm run build:web && playwright test",
    "lint": "eslint frontend/src scripts/*.mjs vite.config.mjs",
    "arch:cycles": "madge --circular --extensions js frontend/src",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run test && npm run arch:cycles && npm run build:web && node scripts/check-architecture.mjs --strict",
    "verify:full": "npm run lint && npm run test:coverage && npm run test:coverage:check && npm run test:density && npm run arch:cycles && npm run build:web && node scripts/check-architecture.mjs --strict",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "madge": "^8.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.40"
  }
}
