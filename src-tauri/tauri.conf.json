{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VersePC2",
  "version": "0.4.0",
  "identifier": "com.versepc.launcher",
  "build": {
    "frontendDist": "../frontend-tauri",
    "beforeDevCommand": "node scripts/prepare-frontend.mjs",
    "beforeBuildCommand": "node scripts/prepare-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VersePC2 - Minecraft Launcher",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 450,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#0b1020",
        "devtools": true,
        "additionalBrowserArgs": "--js-flags=--expose-gc"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
