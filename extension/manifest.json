{
  "manifest_version": 3,
  "name": "VersePC2 下载接管",
  "version": "1.2.3",
  "description": "拦截浏览器下载，交给你本机的 VersePC2 启动器用高速多线程引擎下载。只填表，绝不自动开始。",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VersePC2 下载接管",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
